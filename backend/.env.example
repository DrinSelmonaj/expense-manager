# Kopjo si .env dhe plotëso vlerat — .env është në .gitignore

# PostgreSQL (nëse lihen bosh: localhost:5432, përdoruesi i sistemit)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_manager
DB_USER=
DB_PASSWORD=

# Porti i API-t (frontend/js/api.js pret 3000)
PORT=3000

# Gmail SMTP — EMAIL_PASS duhet të jetë "App Password", jo fjalëkalimi i llogarisë
EMAIL_USER=
EMAIL_PASS=

# Vlerat rezervë kur s'ka konfigurim të ruajtur nga UI-ja
ALERT_EMAIL=
ALERT_LIMIT=500
